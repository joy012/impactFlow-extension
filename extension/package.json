{
  "name": "extension",
  "displayName": "ImpactFlow",
  "description": "Behavioral change intelligence for AI-assisted development.",
  "version": "0.0.1",
  "private": true,
  "publisher": "joy012",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joy012/impactflow.git"
  },
  "homepage": "https://github.com/joy012/impactflow#readme",
  "bugs": {
    "url": "https://github.com/joy012/impactflow/issues"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "SCM Providers",
    "Testing",
    "AI",
    "Visualization"
  ],
  "keywords": [
    "impact analysis",
    "behavior diff",
    "code review",
    "ai code review",
    "byok ai",
    "vscode lm",
    "caller tree",
    "call graph",
    "blast radius",
    "risk score",
    "hotspot",
    "dead code",
    "stale doc",
    "complexity",
    "coverage",
    "pre-commit",
    "git",
    "tree-sitter",
    "typescript",
    "python",
    "go",
    "java",
    "rust",
    "cursor",
    "copilot",
    "claude",
    "ollama"
  ],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "impactflow",
          "title": "ImpactFlow",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "impactflow": [
        {
          "type": "webview",
          "id": "impactflow.sidePanel",
          "name": "Impact",
          "icon": "media/activitybar.svg",
          "contextualTitle": "ImpactFlow"
        }
      ]
    },
    "commands": [
      {
        "command": "impactflow.analyzeNow",
        "title": "Analyze",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.summarizeStaged",
        "title": "Summarize Staged",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.compareBranches",
        "title": "Compare Branches",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.toggleFocusMode",
        "title": "Focus Mode",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.findDeadCode",
        "title": "Find Dead Code",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.cleanupDeadCode",
        "title": "Clean Dead Code",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.refreshCoverage",
        "title": "Refresh Coverage",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.draftCommitMessage",
        "title": "Draft Commit Msg",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.draftPrDescription",
        "title": "Draft PR",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.installPreCommit",
        "title": "Install Hook (warn)",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.installPreCommitBlock",
        "title": "Install Hook (block)",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.uninstallPreCommit",
        "title": "Uninstall Hook",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.resetBaseline",
        "title": "Reset Baseline",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.resetDismissals",
        "title": "Reset Dismissals",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.showPerf",
        "title": "Perf Diagnostics",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.sendFeedback",
        "title": "Send Feedback",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.reportBug",
        "title": "Report Bug",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.requestFeature",
        "title": "Request Feature",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.ai.explainChange",
        "title": "AI: Explain Change",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.ai.suggestTests",
        "title": "AI: Suggest Tests",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.ai.reviewHighRisk",
        "title": "AI: Review High-Risk Change",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.ai.clearCache",
        "title": "AI: Clear Response Cache",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.ai.updateDocs",
        "title": "AI: Update Docs",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.ai.whyRisk",
        "title": "AI: Why High-Risk?",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.ai.triage",
        "title": "AI: Triage Snapshot",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.jumpToFn",
        "title": "Jump to Function",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.cycleSeverity",
        "title": "Cycle Severity Filter",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.showCallerTree",
        "title": "Show Caller Tree (Markdown)",
        "category": "ImpactFlow"
      },
      {
        "command": "impactflow.showCallerTreeVisual",
        "title": "Show Caller Tree (Visual)",
        "category": "ImpactFlow"
      }
    ],
    "configuration": {
      "title": "ImpactFlow",
      "properties": {
        "impactflow.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable ImpactFlow analysis."
        },
        "impactflow.languages": {
          "type": "array",
          "default": [
            "typescript",
            "typescriptreact",
            "javascript",
            "javascriptreact",
            "python",
            "go",
            "dart",
            "java",
            "kotlin"
          ],
          "description": "Language IDs ImpactFlow analyzes."
        },
        "impactflow.include": {
          "type": "array",
          "default": ["**/*.{ts,tsx,js,jsx,mjs,cjs,py,pyi,go,dart,java,kt,kts}"],
          "description": "Glob patterns of files to include."
        },
        "impactflow.exclude": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/out/**",
            "**/*.test.ts",
            "**/*.spec.ts"
          ],
          "description": "Glob patterns of files to exclude."
        },
        "impactflow.baseline.inline": {
          "type": "string",
          "enum": ["head", "lastSave"],
          "default": "head",
          "description": "Baseline used for inline / side panel diffs."
        },
        "impactflow.baseline.commit": {
          "type": "string",
          "enum": ["branchBase", "head"],
          "default": "branchBase",
          "description": "Baseline used for commit-time summaries."
        },
        "impactflow.severity.show": {
          "type": "string",
          "enum": ["all", "low", "medium", "high"],
          "default": "medium",
          "description": "Minimum severity to surface in the side panel."
        },
        "impactflow.decorations.inline": {
          "type": "boolean",
          "default": true,
          "description": "Show inline gutter decorations on changed functions."
        },
        "impactflow.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "Send anonymous usage counts (no source code, no paths). Opt-in only."
        },
        "impactflow.feedback.enable": {
          "type": "boolean",
          "default": true,
          "description": "Allow sending feedback / bug reports from the side panel."
        },
        "impactflow.feedback.endpoint": {
          "type": "string",
          "default": "https://api.web3forms.com/submit",
          "description": "HTTPS endpoint that receives feedback submissions."
        },
        "impactflow.feedback.includeEnv": {
          "type": "boolean",
          "default": true,
          "description": "Include OS / VS Code version / extension version in submissions."
        },
        "impactflow.feedback.githubIssuesUrl": {
          "type": "string",
          "default": "https://github.com/joy012/impactflow/issues/new",
          "description": "Fallback URL when the feedback endpoint is unreachable."
        },
        "impactflow.ui.density": {
          "type": "string",
          "enum": ["compact", "comfortable"],
          "default": "comfortable",
          "description": "Side panel row density. compact = 22px, comfortable = 32px."
        },
        "impactflow.maxFileSizeKb": {
          "type": "number",
          "default": 512,
          "description": "Skip files larger than this (KB) to keep the extension host responsive."
        },
        "impactflow.cleanup.requireGitClean": {
          "type": "boolean",
          "default": true,
          "description": "Dead-code cleanup refuses to run on a dirty working tree unless this is false."
        },
        "impactflow.cleanup.preserveGlob": {
          "type": "array",
          "default": [
            "**/index.*",
            "**/bin/**",
            "**/cli/**",
            "**/main.*",
            "**/pages/**",
            "**/app/**",
            "**/api/**",
            "**/routes/**",
            "**/*.gen.*",
            "**/*_pb.*",
            "**/generated/**"
          ],
          "description": "Globs that dead-code cleanup will never offer to remove."
        },
        "impactflow.notify.webhookUrl": {
          "type": "string",
          "default": "",
          "description": "Optional HTTPS webhook. POSTed when a HIGH-severity diff lands. Payload includes function name + file path + risk score; no source code. Throttled to 1 POST per function per 5 min."
        },
        "impactflow.preCommit.mode": {
          "type": "string",
          "enum": ["warn", "block"],
          "default": "warn",
          "description": "Pre-commit hook mode. warn = exit 0; block = exit 1. Always bypassable via --no-verify."
        },
        "impactflow.ai.enable": {
          "type": "boolean",
          "default": false,
          "description": "Enable BYOK AI commands (Explain Change / Suggest Tests / Review). Uses VS Code's Language Model API — pick your model in VS Code settings. The extension never sees an API key."
        },
        "impactflow.ai.preferredModel": {
          "type": "string",
          "default": "",
          "description": "Optional model selector hint, format `vendor/family` (e.g. `copilot/gpt-4o`). Empty = first available model."
        },
        "impactflow.ai.cacheTtlHours": {
          "type": "number",
          "default": 24,
          "description": "How long to cache AI responses (by function ID + body hash). Repeated calls on the same unchanged function hit the cache, free."
        },
        "impactflow.ai.maxPromptTokens": {
          "type": "number",
          "default": 2000,
          "description": "Hard cap on prompt tokens per call. Prevents accidental token burn."
        },
        "impactflow.ai.maxResponseTokens": {
          "type": "number",
          "default": 1000,
          "description": "Hard cap on response tokens per call (estimated; stops streaming when reached)."
        },
        "impactflow.ai.rateLimitSeconds": {
          "type": "number",
          "default": 60,
          "description": "Minimum seconds between AI calls for the same function."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "impactflow.getStarted",
        "title": "Get Started with ImpactFlow",
        "description": "Understand what behavior changed in your system after every code modification.",
        "steps": [
          {
            "id": "intro",
            "title": "What ImpactFlow does",
            "description": "ImpactFlow analyzes **behavioral changes** — not just file structure — and surfaces what other modules in your system might be affected.\n\nOpen the side panel from the activity bar to see live impact analysis.",
            "media": {
              "markdown": "media/walkthrough/intro.md"
            }
          },
          {
            "id": "tryIt",
            "title": "Try it on your code",
            "description": "Edit any function in a TypeScript file. ImpactFlow will list the change in the side panel and rank possibly-affected modules.",
            "media": {
              "markdown": "media/walkthrough/try-it.md"
            }
          },
          {
            "id": "feedback",
            "title": "Tell us what you think",
            "description": "ImpactFlow is in beta. Send feedback, file bugs, or request features directly from the side panel.\n\n[Send feedback](command:impactflow.sendFeedback)",
            "media": {
              "markdown": "media/walkthrough/feedback.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "pnpm run build:webview && pnpm run build:host",
    "build:host": "pnpm run build:grammars && node esbuild.config.mjs --production",
    "build:grammars": "node scripts/copy-grammars.mjs",
    "build:webview": "pnpm --filter webview build && node scripts/copy-webview.mjs",
    "dev": "pnpm run build:grammars && pnpm run build:webview && node esbuild.config.mjs --watch",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build:grammars && vitest run --passWithNoTests",
    "build:integration": "tsc -p test/integration/tsconfig.json",
    "test:integration": "pnpm run build && pnpm run build:integration && vscode-test",
    "bench": "pnpm run build:grammars && node scripts/bench.mjs",
    "package": "pnpm run build && vsce package --no-dependencies",
    "clean": "rm -rf dist out"
  },
  "devDependencies": {
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "@tree-sitter-grammars/tree-sitter-lua": "^0.4.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cli": "^0.26.9",
    "tree-sitter-dart": "^1.0.0",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-fsharp": "^0.1.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-objc": "^3.0.2",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-powershell": "^0.26.4",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "simple-git": "^3.27.0",
    "web-tree-sitter": "^0.26.9"
  }
}
